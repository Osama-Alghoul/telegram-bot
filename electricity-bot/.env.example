TELEGRAM_BOT_TOKEN=123456789:your-bot-token-from-botfather

# The bot must be added as an ADMIN of this channel (Telegram requires that
# for bots to check who's a member). Public channel -> use its @username.
# Private channel -> use its numeric id (e.g. -1001234567890).
CHANNEL_ID=@your_channel_username

# Shown to users as the "Join the channel" button.
# Public channel: https://t.me/your_channel_username
# Private channel: an invite link you generate from the channel's Admins/Invite Links screen.
CHANNEL_INVITE_LINK=https://t.me/your_channel_username
